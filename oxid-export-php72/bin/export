#!/usr/bin/env php
<?php

declare(strict_types=1);

use Mojo\OxidExport\Command\ExportCommand;
use Symfony\Component\Console\Application;

$autoload = __DIR__ . '/../vendor/autoload.php';
if (!is_file($autoload)) {
    fwrite(STDERR, "Run `composer install` in the oxid-export-php72 directory first.\n");
    exit(1);
}
require $autoload;

$command = new ExportCommand();

$application = new Application('OXID 6.3 → JSON Exporter (PHP 7.2)', '1.0.0');
$application->add($command);
$name = $command->getName();
$application->setDefaultCommand($name !== null ? $name : 'oxid:export', true);
$application->run();
