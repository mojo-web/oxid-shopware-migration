{
    "name": "mojo/oxid-export",
    "description": "OXID 6.3 \u2192 JSON exporter (PHP 8.2+): products+images, image export to directory, categories, customers+addresses",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "ext-json": "*",
        "ext-pdo": "*",
        "ext-mbstring": "*",
        "symfony/console": "^6.4 || ^7.0",
        "symfony/yaml": "^6.4 || ^7.0",
        "doctrine/dbal": "^3.6 || ^4.0"
    },
    "autoload": {
        "psr-4": {
            "Mojo\\OxidExport\\": "src/"
        }
    },
    "bin": [
        "bin/export"
    ],
    "config": {
        "sort-packages": true
    }
}
